// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
  "name": "thc: HotKnobs - Backend",
  "dockerComposeFile": "./docker-compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/backend",
  "customizations": {
    "vscode": {
      "extensions": [
        "42Crunch.vscode-openapi",
        "DrBlury.protobuf-vsc",
        "EditorConfig.EditorConfig",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-github-actions",
        "Gruntfuggly.todo-tree",
        "Redis.redis-for-vscode",
        "dbaeumer.vscode-eslint",
        "davidnussio.vscode-jq-playground",
				"esbenp.prettier-vscode",				
        "formulahendry.dotnet-test-explorer",
        "humao.rest-client",
        "jq-syntax-highlighting.jq-syntax-highlighting",
        "mongodb.mongodb-vscode",
        "ms-azure-devops.azure-pipelines",
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-apimanagement",
        "ms-azuretools.vscode-azure-github-copilot",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-cosmosdb",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-ossdata.vscode-pgsql",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-vscode.azurecli",
        "patcx.vscode-nuget-gallery",
        "rioj7.command-variable",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "task.vscode-task",
        "timonwong.shellcheck",
        "typespec.typespec-vscode",
        "znck.grammarly"
      ]
    }
  },
  "features": {
		// https://github.com/devcontainers/features/tree/main/src/azure-cli
		"ghcr.io/devcontainers/features/azure-cli:1": {
			"installBicep": true,
			"version": "latest",
			"bicepVersion": "latest"
		},
		// https://github.com/devcontainers/features/tree/main/src/common-utils
		"ghcr.io/devcontainers/features/common-utils:2": {},
		// https://github.com/devcontainers/features/tree/main/src/docker-in-docker
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"azureDnsAutoDetection": true,
			"dockerDashComposeVersion": "v2",
			"installDockerBuildx": true,
			"installDockerComposeSwitch": true,
			"version": "latest"
		},
		// https://github.com/devcontainers/features/tree/main/src/dotnet
		"ghcr.io/devcontainers/features/dotnet:2": {
			"version": "latest"
		},
		// https://github.com/devcontainers/features/tree/main/src/node
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		// https://github.com/devcontainers/features/tree/main/src/python
		"ghcr.io/devcontainers/features/python:1": {
			"version": "latest"
		},
		// https://github.com/devcontainers-community/npm-features/tree/main/src/typescript
		"ghcr.io/devcontainers-community/npm-features/typescript:1": {
			"version": "latest"
		},
		// https://github.com/devcontainers-extra/features/tree/main/src/go-task
		"ghcr.io/devcontainers-extra/features/go-task:1": {
			"version": "latest"
		},
		// https://github.com/devcontainers-extra/features/tree/main/src/pnpm
		"ghcr.io/devcontainers-extra/features/pnpm:2": {
			"version": "latest"
		},
		// https://github.com/devcontainer-community/devcontainer-features/tree/main/src/charmbracelet-gum
		"ghcr.io/devcontainer-community/devcontainer-features/charmbracelet-gum:1": {
			"version": "latest"
		},
		// https://github.com/devcontainer-community/devcontainer-features/tree/main/src/jq
		"ghcr.io/devcontainer-community/devcontainer-features/jq:1": {
			"version": "latest"
		},
		// https://github.com/devcontainer-community/devcontainer-features/tree/main/src/yq
		"ghcr.io/devcontainer-community/devcontainer-features/yq:1": {
			"version": "latest"
		},
		// https://github.com/rocker-org/devcontainer-features/tree/main/src/apt-packages
		"ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
			"upgradePackages": true,
			"packages": "apt-transport-https,ca-certificates,curl,dnsutils,gnupg,inetutils-ping,mc,nano,python3-pip"
		}
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [
  //   5432
  // ],
  // "portsAttributes": {
  // 		"5001": {
  // 			"protocol": "https"
  // 		}
  // }
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": [
    ".devcontainer/init.sh"
  ]
}
