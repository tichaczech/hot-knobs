    <ProjectReference Include="..\Implementation\Dummy.Implementation.csproj" />
    <ProjectReference Include="..\Persistence.Cosmos\Dummy.Persistence.Cosmos.csproj" />
    <ProjectReference Include="..\Persistence.Mongo\Dummy.Persistence.Mongo.csproj" />
    <ProjectReference Include="..\Persistence.Postgres\Dummy.Persistence.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- <PackageReference Include="Fand.Runtime.Queues.AzureStorageAccount" /> -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" />
  </ItemGroup>

</Project>
