<Project>
  <!-- Output path configuration -->
  <PropertyGroup>
    <!-- https://github.com/dotnet/msbuild/discussions/7669 -->
    <!-- https://learn.microsoft.com/en-us/dotnet/core/sdk/artifacts-output -->
    <!-- https://github.com/dotnet/sdk/blob/main/src/Tasks/Microsoft.NET.Build.Tasks/targets/Microsoft.NET.DefaultOutputPaths.targets -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../_artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- Configuration files support -->
  <Choose>
    <When Condition="($(MSBuildProjectName.EndsWith('.Server')) And !$(MSBuildProjectName.EndsWith('Runtime.Server'))) Or ($(MSBuildProjectName.EndsWith('.Worker')) And !$(MSBuildProjectName.EndsWith('Runtime.Worker')))">
      <ItemGroup>
        <Content Include="..\..\..\appsettings.json" CopyToOutputDirectory="Always">
          <Link>appsettings.json</Link>
        </Content>
        <Content Include="..\appsettings.Module.json" CopyToOutputDirectory="Always">
          <Link>appsettings.Module.json</Link>
          <DependentUpon>appsettings.json</DependentUpon>
        </Content>
      </ItemGroup>
      <ItemGroup Condition="Exists('..\..\..\appsettings.Local.json')">
        <Content Include="..\..\..\appsettings.Local.json" CopyToOutputDirectory="Always">
          <Link>appsettings.Local.json</Link>
          <DependentUpon>appsettings.json</DependentUpon>
        </Content>
      </ItemGroup>
      <ItemGroup Condition="Exists('..\appsettings.Module.Local.json')">
        <Content Include="..\appsettings.Module.Local.json" CopyToOutputDirectory="Always">
          <Link>appsettings.Module.Local.json</Link>
          <DependentUpon>appsettings.Module.json</DependentUpon>
        </Content>
      </ItemGroup>
      <Choose>
        <When Condition="$(MSBuildProjectName.EndsWith('.Server'))">
          <ItemGroup Condition="Exists('appsettings.Module.Server.json')">
            <None Include="appsettings.Module.Server.json" CopyToOutputDirectory="Always">
              <Link>appsettings.Module.Server.json</Link>
              <DependentUpon>appsettings.Module.json</DependentUpon>
            </None>
          </ItemGroup>
          <ItemGroup Condition="Exists('appsettings.Module.Server.Local.json')">
            <None Include="appsettings.Module.Server.Local.json" CopyToOutputDirectory="Always">
              <Link>appsettings.Module.Server.Local.json</Link>
              <DependentUpon>appsettings.Module.Server.json</DependentUpon>
            </None>
          </ItemGroup>
        </When>
        <When Condition="$(MSBuildProjectName.EndsWith('.Worker'))">
          <ItemGroup Condition="Exists('appsettings.Module.Worker.json')">
            <None Include="appsettings.Module.Worker.json" CopyToOutputDirectory="Always">
              <Link>appsettings.Module.Worker.json</Link>
              <DependentUpon>appsettings.Module.json</DependentUpon>
            </None>
          </ItemGroup>
          <ItemGroup Condition="Exists('appsettings.Module.Worker.Local.json')">
            <None Include="appsettings.Module.Worker.Local.json" CopyToOutputDirectory="Always">
              <Link>appsettings.Module.Worker.Local.json</Link>
              <DependentUpon>appsettings.Module.Worker.json</DependentUpon>
            </None>
          </ItemGroup>
        </When>
      </Choose>
    </When>
  </Choose>

  <!-- Documentation generation -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- When no path defined only - e.g. CI/CD pipeline can define own CoverletOutput -->
    <DocumentationFile Condition="'$(DocumentationFile)'!=''">$(MSBuildThisFileDirectory)../_artifacts/docs/$(MSBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>

  <!-- Code coverage configuration for Test projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- When no path defined only - e.g. CI/CD pipeline can define own CoverletOutput -->
    <CoverletOutput>$(MSBuildThisFileDirectory)../_artifacts/tests/$(MSBuildProjectName).xml</CoverletOutput>
  </PropertyGroup>

  <!-- Documentation generation -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InheritDocEnabled>true</InheritDocEnabled>
  </PropertyGroup>
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- Includes inherited documentation into final XML -->
    <!-- <PackageReference Include="SauceControl.InheritDoc">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference> -->
  </ItemGroup>

  <!-- Code coverage configuration for Test projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
  </PropertyGroup>

  <!-- Naming convention -->
  <PropertyGroup>
    <DefaultAssemblyName>thc.HotKnobs</DefaultAssemblyName>
	<DefaultRootNamespace>thc.HotKnobs</DefaultRootNamespace>
  </PropertyGroup>

  <!-- Versioning configuration -->
  <PropertyGroup>
    <!-- When no version defined only - e.g. CI/CD pipeline can define own Version -->
    <Version Condition="'$(Version)'==''">$([System.DateTime]::Now.ToString('yyyy.Mdd.HHmm'))-dev</Version>
  </PropertyGroup>

  <!-- SDK/Runtime configuration -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Static code analysis / Code style -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Server')) Or $(MSBuildProjectName.EndsWith('.Worker'))">
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- NuGet configuration -->
  <PropertyGroup>
    <!-- Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Lock file support -->
    <!-- <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile> -->

    <!-- NuGet / Project refrence switch -->
    <FandFrameworkCommonAsProjectReference>true</FandFrameworkCommonAsProjectReference>

    <!-- Default NuGet / Publish options -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- Enable internals visibility to test projects -->
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

  <!-- Define constants for all projects -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);ASYNC_ENUMERABLE</DefineConstants>
  </PropertyGroup>

  <!-- Standard references for Test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MockQueryable.FakeItEasy" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
