{
	"AllowedHosts": "*",
	"Logging": {
		"LogLevel": {
			"Default": "Information"
		}
	},
	"HotKnobs": {
		"Runtime": {
			"Authentication": {
				"RequireExpirationTime": true,
				"RequireSignedTokens": true,
				"RequireAudience": true,
				"ValidateActor": false,
				"ValidateAudience": true,
				"ValidateIssuer": true,
				"ValidateIssuerSigningKey": false,
				"ValidateLifetime": true,
				"ValidateTokenReplay": false
			},
			"Cache": {
				"ConnectionString": "ConnectionStringName=ApplicationCache",
				"CryptographyOptions": {
					"Algorithm": "RSA-OAEP",
					"InitializationVector": [
						243,
						35,
						239,
						167,
						179,
						33,
						87,
						127,
						196,
						240,
						64,
						199,
						205,
						74,
						191,
						42
					],
					"KeyWrapAlgorithm": "RSA-OAEP-256",
					"KeyWrapKeyId": "redis"
				}
			},
			"Persistence": {
				"CosmosDB": {
					"ConnectionString": "ConnectionStringName=CosmosDB"
				},
				"MongoDB": {
					"ConnectionString": "ConnectionStringName=MongoDB"
				},
				"PostgresSQL": {
					"ConnectionString": "ConnectionStringName=PostgreSQL"
				}
			},
			"KeyVault": {
				"Application": {
					"EncryptionAlgorithm": "RSA-OAEP-256"
				}
			},
			"Queues": {
				"Application": {
					"ConnectionString": "ConnectionStringName=ApplicationStorageAccount"
				}
			},
			"Storage": {
				"Application": {
					"ConnectionString": "ConnectionStringName=ApplicationStorageAccount"
				}
			}
		},
		"Domains": {
			"Certificates": {},
			"Keys": {},
			"Secrets": {}
		},
		"ServiceDiscovery": {
			"RetryCount": 2,
			"RetrySeconds": 1
		},
		"Shared": {
			"JIPProxy": {
				"JIP": {
					"TimeZone": "Central Europe Standard Time"
				}
			}
		}
	}
}
