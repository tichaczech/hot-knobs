<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Naming convention -->
  <PropertyGroup>
    <DefaultAssemblyName>$(DefaultAssemblyName).Shared.$(MSBuildProjectName)</DefaultAssemblyName>
	  <DefaultRootNamespace>$(DefaultRootNamespace).Shared</DefaultRootNamespace>

    <ArtifactsProjectName>Shared.$(MSBuildProjectName)</ArtifactsProjectName>
  </PropertyGroup>

</Project>
