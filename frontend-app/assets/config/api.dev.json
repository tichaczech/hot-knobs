{
    "base_url": "https://dev.hotknobs.app/api",
    "endpoints": {
        "domains.users.profiles": {
            "path": "/domains/users/profiles",
            "methods": {
                "get": {
                    "path": "/{id}",
                    "scopes": [
                        "users.device.read",
                        "users.device.write",
                        "users.profile.read",
                        "users.profile.write"
                    ]
                },
                "list": {
                    "scopes": [
                        "users.device.read",
                        "users.device.write",
                        "users.profile.read",
                        "users.profile.write"
                    ]
                },
                "patch": {
                    "path": "/{id}",
                    "scopes": [
                        "users.device.read",
                        "users.device.write",
                        "users.profile.read",
                        "users.profile.write"
                    ]
                },
                "post": {
                    "scopes": [
                        "users.device.read",
                        "users.device.write",
                        "users.profile.read",
                        "users.profile.write"
                    ]
                }
            }
        },
        "domains.sites": {
            "path": "/sites",
            "scopes": [
                "sites.read"
            ]
        }
    }
}
